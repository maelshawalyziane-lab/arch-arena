From b95f3452605e3b1244b30497d1f250d34d14982a Mon Sep 17 00:00:00 2001
From: ARCH Arena <arch-arena@example.com>
Date: Sun, 11 Oct 2026 21:08:22 +0000
Subject: [PATCH] bootstrap : repare un compte cree sans mot de passe

Sur un hebergeur sans acces shell, un compte cree par un premier deploiement ou
ARCH_ADMIN_PASSWORD etait absent restait inaccessible pour toujours. Un
redeploiement avec la variable pose desormais le mot de passe (uniquement si le
compte n'en a pas d'utilisable : un mot de passe choisi n'est jamais ecrase).
---
 problems/management/commands/bootstrap.py | 10 +++++
 problems/tests/test_bootstrap.py          | 12 ++++++
 var/translations.jsonl                    | 50 +++++++++++++++++++++++
 3 files changed, 72 insertions(+)

diff --git a/problems/management/commands/bootstrap.py b/problems/management/commands/bootstrap.py
index 80715e9..3614f8d 100644
--- a/problems/management/commands/bootstrap.py
+++ b/problems/management/commands/bootstrap.py
@@ -77,6 +77,16 @@ class Command(BaseCommand):
                 user = User.objects.create_superuser(username=username, password=password or None)
             self.stdout.write(f"  compte créé          : {username}")
             return
+        # Réparation : si le compte a été créé **sans** mot de passe (variable absente au
+        # premier démarrage), il est inaccessible — et sur un hébergeur sans accès shell,
+        # `changepassword` n'existe pas. Si un mot de passe est fourni maintenant, on le
+        # repose ; sinon on ne touche à rien (le mot de passe choisi reste le bon).
+        if password and not user.has_usable_password():
+            user.set_password(password)
+            user.is_superuser = user.is_staff = True
+            user.save(update_fields=["password", "is_superuser", "is_staff"])
+            self.stdout.write(f"  compte réparé        : {username} (mot de passe défini)")
+            return
         self.stdout.write(f"  compte déjà présent  : {username} (mot de passe inchangé)")
 
     def _corpus_is_ready(self) -> bool:
diff --git a/problems/tests/test_bootstrap.py b/problems/tests/test_bootstrap.py
index 0109455..a817387 100644
--- a/problems/tests/test_bootstrap.py
+++ b/problems/tests/test_bootstrap.py
@@ -42,3 +42,15 @@ class BootstrapTests(TestCase):
         with mock.patch.dict(os.environ, {"ARCH_ADMIN_PASSWORD": "depuis-environnement"}):
             call_command("bootstrap", skip_corpus=True, verbosity=0)
         self.assertIsNotNone(authenticate(username="admin", password="depuis-environnement"))
+
+    def test_repairs_an_account_created_without_a_password(self):
+        """Un compte créé sans mot de passe doit devenir utilisable.
+
+        C'est le cas d'un premier déploiement où ARCH_ADMIN_PASSWORD était absent :
+        le compte existe mais reste inaccessible, et un hébergeur sans shell ne permet
+        pas de lancer `changepassword`. Un redéploiement avec la variable doit réparer.
+        """
+        User = get_user_model()
+        User.objects.create_superuser(username="admin", password=None)   # inutilisable
+        call_command("bootstrap", skip_corpus=True, password="nouveau-mdp", verbosity=0)
+        self.assertIsNotNone(authenticate(username="admin", password="nouveau-mdp"))
