diff --git a/problems/tests/test_account_and_provider.py b/problems/tests/test_account_and_provider.py
index 317f608..adec862 100644
--- a/problems/tests/test_account_and_provider.py
+++ b/problems/tests/test_account_and_provider.py
@@ -202,3 +202,35 @@ class GraderResilienceTests(TestCase):
                 self.assertTrue(verdict.engine.startswith("repli:"))
         self.assertEqual(caller.call_count, 1, "le disjoncteur doit couper après le premier échec")
         self.assertNotEqual(ai_grader.breaker_state(), "fermé")
+
+
+class HealthCheckTests(TestCase):
+    """La sonde de santé des hébergeurs.
+
+    Elle est interrogée pendant le déploiement, en HTTP simple, sans session : elle
+    doit répondre 200 dans tous les cas. Une redirection vers HTTPS y serait comptée
+    comme un échec de déploiement (c'est arrivé sur Render).
+    """
+
+    def test_answers_without_being_logged_in(self):
+        response = self.client.get("/healthz/")
+        self.assertEqual(response.status_code, 200)
+        self.assertEqual(response.json()["status"], "ok")
+
+    @override_settings(
+        SECURE_SSL_REDIRECT=True,
+        SECURE_PROXY_SSL_HEADER=("HTTP_X_FORWARDED_PROTO", "https"),
+        SECURE_REDIRECT_EXEMPT=[r"^healthz/$"],
+    )
+    def test_is_exempt_from_the_https_redirect(self):
+        response = self.client.get("/healthz/", secure=False)
+        self.assertEqual(response.status_code, 200)
+
+    @override_settings(
+        SECURE_SSL_REDIRECT=True,
+        SECURE_PROXY_SSL_HEADER=("HTTP_X_FORWARDED_PROTO", "https"),
+        SECURE_REDIRECT_EXEMPT=[r"^healthz/$"],
+    )
+    def test_the_other_pages_still_force_https(self):
+        response = self.client.get("/accounts/login/", secure=False)
+        self.assertEqual(response.status_code, 301)
diff --git a/problems/views.py b/problems/views.py
index b6b011b..73d2df2 100644
--- a/problems/views.py
+++ b/problems/views.py
@@ -574,3 +574,13 @@ def signup_view(request):
 @login_required
 def dashboard_redirect(request):  # pragma: no cover - convenience alias
     return redirect("dashboard")
+
+
+def healthz(request):
+    """Sonde de santé — la seule page qui répond sans connexion ni HTTPS forcé.
+
+    Les plateformes d'hébergement interrogent cette adresse pendant le déploiement
+    (*Health Check Path*). Elle ne dépend donc de rien : ni base de données, ni session,
+    ni redirection. Une 301 y serait comptée comme un échec de déploiement.
+    """
+    return JsonResponse({"status": "ok", "service": "arch-arena"})
