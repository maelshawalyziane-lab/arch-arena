# =============================================================================
#  arch-olympiad · environment template
#  Copy to `.env` (or export these vars) and edit.  Everything has a safe
#  development default, so an empty environment still runs on SQLite.
#      cp .env.example .env && set -a && . ./.env && set +a
# =============================================================================

# --- core -------------------------------------------------------------------
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
# Comma separated, scheme included.  The in-app preview runs on *.e2b.app:
DJANGO_CSRF_TRUSTED_ORIGINS=https://*.e2b.app
DJANGO_TIME_ZONE=Asia/Dubai

# --- database ---------------------------------------------------------------
# Precedence: DATABASE_URL  >  POSTGRES_*  >  bundled SQLite (db.sqlite3).
# SQLite is the zero-config demo default; production should use PostgreSQL.
#
# DATABASE_URL=postgres://arch_app:secret@127.0.0.1:5432/arch_olympiad
# POSTGRES_DB=arch_olympiad
# POSTGRES_USER=arch_app
# POSTGRES_PASSWORD=secret
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432

# --- demo / progress --------------------------------------------------------
# 0 = installation mono-compte (le fonctionnement normal : un seul compte, le vôtre).
# 1 = mode démonstration : un compte « invité » partagé, pratique pour montrer
#     l'interface à quelqu'un sans lui donner de mot de passe. Jamais en production.
DEMO_MODE=0
# Lets a signed-in user re-lock a problem (handy for demos and for testing).
ALLOW_PROGRESS_RESET=1
# Inscription fermée : l'installation n'ouvre qu'un seul compte
ALLOW_SIGNUP=0

# --- AI grader --------------------------------------------------------------
# AI_MODE: auto  -> use a live provider when a key is present, else the offline
#                   structural grader (default; the demo needs no key)
#          live  -> require a provider; the endpoint answers 503 without one
#          offline -> always use the deterministic structural grader
AI_MODE=auto
AI_PROVIDER=openai          # openai | anthropic | gemini
AI_MODEL=                   # blank -> provider default (gpt-4o / claude-sonnet-4-5 / gemini-3.5-flash-lite)
                            # gemini : le palier gratuit autorise 500 requêtes/jour sur les
                            # modèles « lite » (gemini-3.5-flash-lite) et 20/jour sur les autres ;
                            # c'est aussi le quota utilisé par translate_corpus.
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
AI_MAX_OUTPUT_TOKENS=700
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- verification gate ------------------------------------------------------
VERIFY_RATE_LIMIT=20            # grading attempts per window per user (0 = off)
VERIFY_RATE_WINDOW_SECONDS=3600
MAX_SUBMISSION_CHARS=20000

# --- production extras (see config/settings_production.py) ------------------
DJANGO_SETTINGS_MODULE=config.settings
# DJANGO_SETTINGS_MODULE=config.settings_production
# DJANGO_SECURE_SSL_REDIRECT=1
# DJANGO_HSTS_SECONDS=31536000
